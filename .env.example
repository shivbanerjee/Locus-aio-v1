TOKEN=your_bot_token_here
CLIENT_ID=your_bot_application_id
BOT_PREFIX=&
SUPPORT_URL=https://discord.gg/your_support
# Comma-separated user IDs (bot owners: no-prefix, gnameplate, syncemojis ...)
OWNER_IDS=123456789012345678

# Lavalink v4 server (music) - hosted or self-hosted
LAVALINK_HOST=
LAVALINK_PORT=443
LAVALINK_PASSWORD=
LAVALINK_SSL=true
LAVALINK_NAME=main

# Optional: channel ID for No Prefix logs
NOPREFIX_LOG_CHANNEL_ID=
